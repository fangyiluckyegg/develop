# 二、OrbStack配置（Docker 运行环境，开机自启） 【安装在管理员账号下，开机自启动】
# 1.OrbStack 多项目部署脚本（可直接复制上线）
# 1）安装 OrbStack（必须）
# 方法 1：官网 DMG 安装（最干净，推荐）
# 1）下载
# 打开官网：https://orbstack.dev/
# 进入 Download，选 Apple Silicon（你的 M2）
# 2）安装
# 打开 .dmg
# 把 OrbStack.app 拖进 Applicatio
# 3）首次启动授权
# Launchpad 打开 OrbStack
# 首次会提示允许虚拟化扩展 → 去「系统设置 → 隐私与安全性」点「允许」
# 菜单栏出现紫色图标，即启动成功
# 2.安装后验证（必做）
# 打开终端，直接用 docker（ OrbStack 自带，无需额外装）：
docker --version
docker ps
# 跑个测试容器
docker run -p 80:80 docker/getting-started
# 浏览器访问 http://localhost，能看到页面就说明完全正常。

# 三、各类容器配置【mysql8、PHP74】
# 目录布置(清空所有容器)
docker stop $(docker ps -aq)
docker rm $(docker ps -aq)
mkdir -p ~/server/{gateway/nginx,db/mysql,db/redis,web/apache-php,backend,frontend,logs,scripts,backup}

# 四、部署mysql8容器:目录 db/mysql,预计空间 3GB,版本 MySQL 8.0（所有项目共用一个 MySQL，多库隔离），每个项目创建独立 DB：project_a_db，project_b_db，project_c_db
# 1.删除旧容器和相应目录
bash
docker rm -f mysql8
rm -rf ~/server/db/mysql/*

# 2.创建容器目录
bash
mkdir -p ~/server/db/mysql/{data,conf,logs,backup}
#chmod -R 777 ~/server/db/mysql

# 3.重新创建 MySQL8 容器,安装mysqli、mysql等函数,配置连接,数据文件外部卷挂载mysql8-data:/var/lib/mysql
bash
docker run -d \
--name mysql8 \
--restart always \
-p 3306:3306 \
-e MYSQL_ROOT_PASSWORD=xuyi20091010 \
-e MYSQL_ROOT_HOST=% \
-v mysql8-data:/var/lib/mysql \
mysql:8.0 \
--default-authentication-plugin=mysql_native_password \
--character-set-server=utf8mb4 \
--collation-server=utf8mb4_unicode_ci

# 4.给 root 授权（允许外部连接）
bash
docker exec -it mysql8 mysql -uroot -pxuyi20091010
# 进去后复制执行：
sql
ALTER USER 'root'@'%' IDENTIFIED WITH mysql_native_password BY 'xuyi20091010';
FLUSH PRIVILEGES;
exit;

# 五、部署PHP74容器【 0.6GB，web/apache-php，用8080端口】Apache2.4.54 + PHP-5.2.17【太老了不支持 ARM 芯片，只能装7.4.33 】  一体化（存量项目拷贝到www目录下即可）
# 第一步：停止并删除现有 PHP 容器
bash
docker rm -f apache-php74

# 第二步：重新创建 PHP 容器 并加入 MySQL 网络，复制整条命令，直接回车：
bash
docker run -d \
--name apache-php74 \
--restart always \
-p 8080:80 \
-v /Users/crh123dexiaohao/server/web:/var/www/html \
--link mysql8:mysql8 \
php:7.4-apache

# 第三步：安装 mysqli（必须）
bash
docker exec apache-php74 docker-php-ext-install mysqli
docker restart apache-php74
# 现在你的数据库配置文件 conn.php 保持这样 不用改
php
$hostname_conn = "mysql8";   ✅ 正确
$database_conn = "你自己的库名";
