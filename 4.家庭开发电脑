5. Nginx 网关路由配置 gateway/nginx/conf.d/bibutong.conf
nginx
server {
    listen 80;
    server_name local.bibutong.com;

    # 前端静态资源转发
    location / {
        proxy_pass http://bibutong-front;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        # 开发环境禁用静态缓存
        expires -1;
    }

    # 后端API接口路由
    location /api/ {
        proxy_pass http://bibutong-backend:8080/api/;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        # 开发全局跨域
        add_header Access-Control-Allow-Origin *;
        add_header Access-Control-Allow-Methods GET,POST,PUT,DELETE,OPTIONS;
    }

    # AI向量接口转发
    location /ai/vector/ {
        proxy_pass http://llama:8000/vector/;
        proxy_set_header Host $host;
    }
}

