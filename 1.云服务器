sudo docker system prune -a -f
sudo rm -rf /opt/hermes ~/hermes
sudo mkdir -p /opt/hermes
sudo chmod 777 /opt/hermes
sudo service docker start

# 二、拉取国内可用镜像（v0.14.0）
sudo docker pull swr.cn-north-4.myhuaweicloud.com/ddn-k8s/docker.io/nousresearch/hermes-agent:v2026.5.16
sudo docker tag swr.cn-north-4.myhuaweicloud.com/ddn-k8s/docker.io/nousresearch/hermes-agent:v2026.5.16 nousresearch/hermes-agent:v2026.5.16

# 三、启动容器（标签用 v2026.5.16）
docker run -d \
  --name hermes \
  --restart unless-stopped \
  -p 9119:9119 \
  -v /root/.hermes:/opt/data \
  --entrypoint /bin/bash \
  nousresearch/hermes-agent:v2026.5.16 \
  -c "sleep 3650d"

