# 一、Hermes 如何安装技能
# 第一步：把技能文件拷入目标位置【把本地技能拷贝到腾讯云root登录界面的文件ftp中】
root@VM-16-13-ubuntu:~# docker cp promotions-collectors.zip hermes:/root/
Successfully copied 6.14kB to hermes:/root/

# 第二步：进入容器，解压 ZIP
# 进入交互式容器终端
docker exec -it hermes bash
# 进入 /root 目录（zip 在这里）
cd /root
cd /root/.hermes/skills/
# 解压到技能总目录 /root/.hermes/skills/
# 需要先安装 unzip（容器内执行）
# 你现在已经在容器里了，直接运行：
apt update && apt install -y unzip
# 再解压你的技能 ZIP（直接运行）
unzip -o promotions-collectors.zip -d /root/.hermes/skills/mytools
# 修复权限（必须做，否则技能加载失败）
chmod -R 755 /root/.hermes/skills/
# 生效技能
mkdir -p /opt/data/skills/mytools
cp -r /root/.hermes/skills/mytools/promotions-collectors /opt/data/skills/mytools
docker restart hermes
#查看是否安装成功
docker exec -it hermes bash
/opt/hermes/.venv/bin/hermes skills list
/skills list

docker exec -it hermes /opt/hermes/.venv/bin/hermes --tui

