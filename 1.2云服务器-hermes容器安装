# Hermes轻应用（容器化配置）
我有一台腾讯云轻量应用服务器（2核4G 6M 70G），系统为Ubuntu 22.04 server 64bit
当前主要功能是作为frp转发的frps服务器端
现计划通过docker来安装配置Hermes_agent，后续准备开发运行一些基于大模型API的AI任务
第一需要带完整依赖包的容器，版本选 v0.14.0【v2026.5.16】
第二大模型选择用deepseek-v4-flash和小米 MiMo-V2.5-Pro（https://token-plan-cn.xiaomimimo.com/v1）
第三打开Dashboard 后台配置面板
请给出一套完整高效稳定的安装和配置方案

# 一、具体配置方案
# 1.彻底清空所有旧东西（必做）
# 管理员权限实施，强制删除（-f）名为hermes的容器，如不存在也不会弹出报错 
sudo docker rm -f hermes 2>/dev/null 
# 管理员权限实施，强制清理（-f）全部资源（-a，需慎重，一般仅-f即可，如容器、镜像、卷、缓存、网络），回收磁盘空间，删除无用资源 
sudo docker system prune -a -f 
# 管理员权限实施，强制、无提示彻底删除两处 Hermes 相关目录（系统程序目录 /opt/hermes；和 当前用户个人目录 ~/hermes）
sudo rm -rf /opt/hermes ~/hermes 
# 管理员权限实施，安全创建 /opt/hermes 目录，重复执行不会报错，适合写进部署脚本
sudo mkdir -p /opt/hermes 
# 管理员权限实施，服务器上任何用户、任何进程都能对 /opt/hermes 内文件增删改查，无权限限制，挂载给 Docker 容器时不会出现权限拒绝报错
# 注意：线上生产环境严禁长期使用 777，任何入侵的普通账号都能篡改、删除目录内配置、密钥、业务数据；
sudo chmod 777 /opt/hermes 
# 更安全的替代方案如下：归属当前用户，权限755（所有者完整权限，其他人只读）
sudo chown -R $USER:$USER /opt/hermes
sudo chmod 755 /opt/hermes
# 如需容器写入，仅开放目录写入权限而非全局777
sudo chmod -R u+w /opt/hermes
# 管理员权限实施，启动docker服务；等价新版本命令sudo systemctl start docker
sudo service docker start 

# 2.拉取国内可用镜像（v0.14.0）
sudo docker pull swr.cn-north-4.myhuaweicloud.com/ddn-k8s/docker.io/nousresearch/hermes-agent:v2026.5.16
sudo docker tag swr.cn-north-4.myhuaweicloud.com/ddn-k8s/docker.io/nousresearch/hermes-agent:v2026.5.16 nousresearch/hermes-agent:v2026.5.16

# 3.启动容器（标签用 v2026.5.16）
docker run -d \
  --name hermes \
  --restart unless-stopped \
  -p 9119:9119 \
  -v /root/.hermes:/opt/data \
  --entrypoint /bin/bash \
  nousresearch/hermes-agent:v2026.5.16 \
  -c "sleep 3650d"

# 4.进入容器初始化 Hermes
sudo docker exec -it hermes bash
# ① 初始化（只跑一次）
/opt/hermes/.venv/bin/hermes init
# 退出容器
exit
# 查看容器是否启动成功
docker ps
# 看到 hermes 容器 UP 状态 = 正在运行！

# 5.配置模型
# 进入容器初始化 Hermes
docker exec -it hermes bash
# 容器内执行（一键创建目录 + 写入正确配置）
mkdir -p /root/.hermes
cat > /opt/data/config.yaml << 'EOF'
providers:
  mimo:
    type: openai_compatible
    base_url: "https://token-plan-cn.xiaomimimo.com/v1"
    api_key: "tp-cpyyl8eut2t2g3069lkxahdbxfc0fkdtmms1as1oqmjb8sre"
    models:
      - mimo-v2.5-pro
model:
  default: mimo/mimo-v2.5-pro
  provider: mimo
EOF

# 6.启动 9119 Dashboard 后台（仅启动网页配置）
# 退出容器
exit
# 启动 9119 面板（最终版）
docker exec -d hermes /opt/hermes/.venv/bin/hermes dashboard --host 0.0.0.0 --port 9119 --insecure

# 附：其他命令
# 命令行测试聊天（TUI 界面）
docker exec -it hermes /opt/hermes/.venv/bin/hermes --tui
# 输入 /model 可随时切换双模型
# 查看完整配置
docker exec -it hermes hermes config show
# 重启容器（如需）
docker restart hermes
# 杀掉旧的占用端口的进程
pkill -f "hermes dashboard"

# 二、Hermes 如何安装技能
# 第一步：把技能文件拷入目标位置【把本地技能拷贝到腾讯云root登录界面的文件ftp中】
root@VM-16-13-ubuntu:~# docker cp promotions-collectors.zip hermes:/root/
Successfully copied 6.14kB to hermes:/root/

# 第二步：进入容器，解压 ZIP
# 进入交互式容器终端
docker exec -it hermes bash
# 进入 /root 目录（zip 在这里）
cd /root
cd /root/.hermes/skills/
# 解压到技能总目录 /root/.hermes/skills/
# 需要先安装 unzip（容器内执行）
# 你现在已经在容器里了，直接运行：
apt update && apt install -y unzip
# 再解压你的技能 ZIP（直接运行）
unzip -o promotions-collectors.zip -d /root/.hermes/skills/mytools
# 修复权限（必须做，否则技能加载失败）
chmod -R 755 /root/.hermes/skills/
# 生效技能
mkdir -p /opt/data/skills/mytools
cp -r /root/.hermes/skills/mytools/promotions-collectors /opt/data/skills/mytools
docker restart hermes
#查看是否安装成功
docker exec -it hermes bash
/opt/hermes/.venv/bin/hermes skills list
/skills list

# 三、如何设置定时任务
# 增加自定义模型
docker exec -it hermes bash
/opt/hermes/.venv/bin/hermes model
# 然后不断回车
[K]eep [R]eplace [c]lear (default K):r
# 选择目标新模型即可
# 想保留任务，又想退出 TUI
方法 A：在容器里先把终端 “detach”（推荐）
Ctrl+P → 松开 → Ctrl+Q

# 常用管理命令（TUI 里直接输入）
/cron list          # 列出所有定时任务（带 ID）
/cron run <id>      # 立即手动跑一次
/cron pause <id>    # 暂停
/cron resume <id>   # 恢复
/cron delete <id>   # 删除

# 标记任务按计划启动
/cron run 907daa773488

# 让网关进程持续运行，推荐用 systemd 做守护进程，开机自启、崩溃自动恢复：
hermes gateway install --system
# 后台ticker启动独立进程，每60秒自动hermes cron tick【cron-ticker脚本：已启动(PID91989,每60 s tick)】
# 注意：当前在Docker容器中运行，ticker生命周期绑定本TUI会话。如果重启容器需要重新启动ticker脚本（或配置Docker--restart unless-stopped+启动时自动运行ticker)。

# 推出tui,立即执行启动看看
docker exec -it hermes /opt/hermes/.venv/bin/hermes cron tick
